@model IEnumerable<Inmobiliaria.Models.TipoInmueble>

@{
    ViewData["Title"] = "Tipos de Inmueble";
}

<h1>Tipos de Inmueble</h1>
<!-- BARRA DE BÚSQUEDA -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="busqueda" class="form-control" placeholder="Buscar por descripción (ej: Casa, Depto)..." value="@ViewBag.BusquedaActual" />
        <button type="submit" class="btn btn-primary">🔍 Buscar</button>
        @if (!string.IsNullOrEmpty(ViewBag.BusquedaActual))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo tipo de inmueble</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Descripción</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Descripcion</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@t.IdTipo" class="btn btn-sm btn-secondary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@t.IdTipo" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>