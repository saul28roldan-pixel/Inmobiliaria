@model IEnumerable<Inmobiliaria.Models.Inmueble>
@{
    ViewData["Title"] = "Inmuebles";
}

<h1>Listado de Inmuebles</h1>

<!-- FORMULARIO DE BÚSQUEDA CON DESPLEGABLE -->
<form asp-action="Index" method="get" class="mb-4 p-3 bg-light rounded border">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Buscar por Dirección o Propietario:</label>
            <input type="text" name="busqueda" class="form-control" placeholder="Ej: Av. Libertador..." value="@ViewBag.BusquedaActual" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Tipo de Inmueble:</label>
            <select name="idTipo" class="form-select">
                <option value="">-- Todos los tipos --</option>
                @foreach (var tipo in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.TiposParaFiltro)
                {
                    <option value="@tipo.Value" selected="@(ViewBag.IdTipoActual?.ToString() == tipo.Value)">@tipo.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">🔍 Buscar</button>
        </div>
        <div class="col-md-3">
            <a asp-action="Index" class="btn btn-secondary w-100">Limpiar filtros</a>
        </div>
    </div>
</form>

<!-- TABLA DE INMUEBLES -->
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Dirección</th>
            <th>Tipo</th>
            <th>Propietario</th>
            <th>Precio/Día</th>
            <th>Disponible</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Direccion</td>
                <td>@item.DescripcionTipo</td>
                <td>@item.NombrePropietario</td>
                <td>$@item.PrecioPorDia</td>
                <td>
                    @if (item.Disponible)
                    {
                        <span class="badge bg-success">Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- PAGINADO -->
@if (ViewBag.TotalPaginas > 1)
{
    <nav aria-label="Paginación de inmuebles">
        <ul class="pagination justify-content-center">
            @{
                int paginaActual = ViewBag.PaginaActual;
                int totalPaginas = ViewBag.TotalPaginas;
                string busqueda = ViewBag.BusquedaActual ?? "";
                string idTipo = ViewBag.IdTipoActual?.ToString() ?? "";
            }

            <!-- Botón Anterior -->
            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-idTipo="@idTipo" asp-route-pagina="@(paginaActual - 1)">Anterior</a>
            </li>

            <!-- Números de página -->
            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-idTipo="@idTipo" asp-route-pagina="@i">@i</a>
                </li>
            }

            <!-- Botón Siguiente -->
            <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-idTipo="@idTipo" asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}