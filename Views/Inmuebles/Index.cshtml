@model IEnumerable<Inmobiliaria.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";
}

<h1>Listado de Inmuebles</h1>
<!--  BARRA DE BÚSQUEDA -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="busqueda" class="form-control" placeholder="Buscar por dirección o propietario..." value="@ViewBag.BusquedaActual" />
        <button type="submit" class="btn btn-primary">🔍 Buscar</button>
        @if (!string.IsNullOrEmpty(ViewBag.BusquedaActual))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>
<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Inmueble</a>
</p>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Direccion)</th>
            <th>@Html.DisplayNameFor(model => model.DescripcionTipo)</th>
            <th>@Html.DisplayNameFor(model => model.NombrePropietario)</th>
            <th>@Html.DisplayNameFor(model => model.PrecioPorDia)</th>
            <th>@Html.DisplayNameFor(model => model.Disponible)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Direccion)</td>
            <td>@Html.DisplayFor(modelItem => item.DescripcionTipo)</td>
            <td>@Html.DisplayFor(modelItem => item.NombrePropietario)</td>
            <td>@Html.DisplayFor(modelItem => item.PrecioPorDia)</td>
            <td>
                @if (item.Disponible)
                {
                    <span class="badge bg-success">Disponible</span>
                }
                else
                {
                    <span class="badge bg-danger">No Disponible</span>
                }
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-info">Detalles</a>
                <a asp-action="Edit" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>