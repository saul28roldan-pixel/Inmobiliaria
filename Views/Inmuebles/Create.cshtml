@model Inmobiliaria.Models.Inmueble

@{
    ViewData["Title"] = "Crear Inmueble";
}

<h1>Crear Inmueble</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- CAMPO PROPIETARIO CON SELECT2 -->
            <div class="form-group mb-3">
                <label asp-for="IdPropietario" class="control-label">Propietario</label>
                <select asp-for="IdPropietario" id="selectPropietario" class="form-control">
                    <option value="">-- Buscar y seleccionar propietario --</option>
                </select>
                <span asp-validation-for="IdPropietario" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IdTipo" class="control-label"></label>
                <select asp-for="IdTipo" class="form-control" asp-items="ViewBag.Tipos">
                    <option value="">-- Seleccione un tipo --</option>
                </select>
                <span asp-validation-for="IdTipo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Direccion" class="control-label"></label>
                <input asp-for="Direccion" class="form-control" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Cupo" class="control-label"></label>
                <input asp-for="Cupo" class="form-control" />
                <span asp-validation-for="Cupo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Coordenadas" class="control-label"></label>
                <input asp-for="Coordenadas" class="form-control" placeholder="ej: -34.6037,-58.3816" />
                <span asp-validation-for="Coordenadas" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PrecioPorDia" class="control-label"></label>
                <input asp-for="PrecioPorDia" class="form-control" />
                <span asp-validation-for="PrecioPorDia" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImagenFile" class="control-label"></label>
                <input asp-for="ImagenFile" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" />
                <span asp-validation-for="ImagenFile" class="text-danger"></span>
                <small class="form-text text-muted">Formatos permitidos: JPG, PNG, WEBP, GIF. Máximo 5 MB.</small>
            </div>

            <div class="form-group mb-3 form-check">
                <input asp-for="Disponible" class="form-check-input" />
                <label asp-for="Disponible" class="form-check-label"></label>
            </div>

            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3">@ViewBag.Error</div>
}

<!-- UNA SOLA SECCIÓN SCRIPTS UNIFICADA -->
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            $('#selectPropietario').select2({
                theme: 'bootstrap-5',
                placeholder: 'Escriba nombre, apellido o DNI...',
                minimumInputLength: 2,
                delay: 300,
                ajax: {
                    url: '/Propietarios/Buscar',
                    dataType: 'json',
                    data: function (params) {
                        return {
                            q: params.term
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data
                        };
                    }
                }
            });
        });
    </script>
}