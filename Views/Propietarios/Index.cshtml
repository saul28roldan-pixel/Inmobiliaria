@model IEnumerable<Inmobiliaria.Models.Propietario>

@{
    ViewData["Title"] = "Propietarios";
}

<h1>Propietarios</h1>
<!-- BARRA DE BÚSQUEDA -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="busqueda" class="form-control" placeholder="Buscar por nombre, apellido o DNI..." value="@ViewBag.BusquedaActual" />
        <button type="submit" class="btn btn-primary">🔍 Buscar</button>
        @if (!string.IsNullOrEmpty(ViewBag.BusquedaActual))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo propietario</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>DNI</th>
            <th>Email</th>
            <th>Teléfono</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Nombre</td>
                <td>@p.Apellido</td>
                <td>@p.Dni</td>
                <td>@p.Email</td>
                <td>@p.Telefono</td>
                <td>
                    <a asp-action="Details" asp-route-id="@p.IdPropietario" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@p.IdPropietario" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@p.IdPropietario" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>