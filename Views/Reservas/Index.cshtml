@model IEnumerable<Inmobiliaria.Models.Reserva>
@{
    ViewData["Title"] = "Reservas";
}

<h1>Listado de Reservas</h1>

<!-- FORMULARIO DE BÚSQUEDA -->
<form asp-action="Index" method="get" class="mb-4 p-3 bg-light rounded border">
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Buscar por Inmueble o Inquilino:</label>
            <input type="text" name="busqueda" class="form-control" placeholder="Ej: Av. Libertador o Juan Pérez..." value="@ViewBag.BusquedaActual" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">🔍 Buscar</button>
        </div>
        <div class="col-md-3">
            <a asp-action="Index" class="btn btn-secondary w-100">Limpiar</a>
        </div>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">➕ Crear Nueva Reserva</a>
</p>

<!-- TABLA DE RESERVAS -->
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Inmueble</th>
            <th>Inquilino</th>
            <th>Desde</th>
            <th>Hasta</th>
            <th>Monto/Día</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdReserva</td>
                <td>@item.Inmueble?.Direccion</td>
                <td>@item.Inquilino?.NombreCompleto</td>
                <td>@item.FechaDesde.ToString("dd/MM/yyyy")</td>
                <td>@item.FechaHasta.ToString("dd/MM/yyyy")</td>
                <td>$@item.MontoDiario</td>
                <td>
                    @if (item.FechaFinalizacion.HasValue)
                    {
                        <span class="badge bg-secondary">Finalizada</span>
                    }
                    else if (item.FechaHasta >= DateTime.Today)
                    {
                        <span class="badge bg-success">Activa</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Vencida</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdReserva" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro de eliminar esta reserva?');">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- PAGINADO -->
@if (ViewBag.TotalPaginas > 1)
{
    <nav aria-label="Paginación de reservas">
        <ul class="pagination justify-content-center">
            @{
                int paginaActual = ViewBag.PaginaActual;
                int totalPaginas = ViewBag.TotalPaginas;
                string busqueda = ViewBag.BusquedaActual ?? "";
            }

            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-pagina="@(paginaActual - 1)">Anterior</a>
            </li>

            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-pagina="@i">@i</a>
                </li>
            }

            <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}