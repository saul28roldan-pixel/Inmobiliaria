@model Inmobiliaria.Models.Reserva

@{
    ViewData["Title"] = "Crear Reserva";
}

<h2>Crear Nueva Reserva</h2>
<hr />
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div class="mb-3">
    <label asp-for="IdInquilino" class="form-label">Inquilino</label>
    <select asp-for="IdInquilino" id="selectInquilino" class="form-select">
        <option value="">-- Buscar inquilino --</option>
    </select>
    <span asp-validation-for="IdInquilino" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="IdInmueble" class="form-label">Inmueble</label>
    <select asp-for="IdInmueble" id="selectInmueble" class="form-select">
        <option value="">-- Buscar inmueble --</option>
    </select>
    <span asp-validation-for="IdInmueble" class="text-danger"></span>
</div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FechaDesde" class="form-label">Fecha Desde</label>
                    <input asp-for="FechaDesde" class="form-control" type="date" />
                    <span asp-validation-for="FechaDesde" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="FechaHasta" class="form-label">Fecha Hasta</label>
                    <input asp-for="FechaHasta" class="form-control" type="date" />
                    <span asp-validation-for="FechaHasta" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="MontoDiario" class="form-label">Monto Diario ($)</label>
                <input asp-for="MontoDiario" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="MontoDiario" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Select2 para Inquilino
            $('#selectInquilino').select2({
                theme: 'bootstrap-5',
                placeholder: 'Escriba nombre o DNI...',
                minimumInputLength: 2,
                delay: 300,
                ajax: {
                    url: '/Inquilinos/Buscar',
                    dataType: 'json',
                    data: function (params) {
                        return { q: params.term };
                    },
                    processResults: function (data) {
                        return { results: data };
                    }
                }
            });

            // Select2 para Inmueble
            $('#selectInmueble').select2({
                theme: 'bootstrap-5',
                placeholder: 'Escriba dirección...',
                minimumInputLength: 2,
                delay: 300,
                ajax: {
                    url: '/Inmuebles/Buscar',
                    dataType: 'json',
                    data: function (params) {
                        return { q: params.term };
                    },
                    processResults: function (data) {
                        return { results: data };
                    }
                }
            });
        });
    </script>
}