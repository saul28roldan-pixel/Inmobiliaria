@model IEnumerable<Inmobiliaria.Models.Reserva>
@{
    ViewData["Title"] = "Informe de Reservas Activas";
}

<div class="container mt-4">
    <h2 class="mb-4">📊 Informe de Reservas Activas</h2>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Reservas Activas</h5>
                    <p class="card-text display-4">@ViewBag.TotalReservasActivas</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Monto Total Estimado</h5>
                    <p class="card-text display-4">$ @ViewBag.MontoTotalEstimado.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Detalle de Reservas</h4>
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID Reserva</th>
                <th>Inmueble</th>
                <th>Inquilino</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th>Monto Diario</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdReserva</td>
                    <td>@item.IdInmueble</td> <!-- Ajusta si tienes navegación a Inmueble -->
                    <td>@item.IdInquilino</td> <!-- Ajusta si tienes navegación a Inquilino -->
                    <td>@item.FechaDesde.ToString("dd/MM/yyyy")</td>
                    <td>@item.FechaHasta.ToString("dd/MM/yyyy")</td>
                    <td>$ @item.MontoDiario.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-action="Index" class="btn btn-secondary">Volver al Listado General</a>
</div>