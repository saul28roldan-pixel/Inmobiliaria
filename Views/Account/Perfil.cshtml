@model Inmobiliaria.Models.Usuario
@{
    ViewData["Title"] = "Mi Perfil";
}

<h2>Mi Perfil</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row mt-4">
    <div class="col-md-4 text-center">
        @if (!string.IsNullOrEmpty(Model.Avatar))
        {
            <img src="@Model.Avatar" alt="Avatar" class="img-thumbnail rounded-circle mb-3" style="width:180px; height:180px; object-fit:cover;" />
        }
        else
        {
            <div class="bg-secondary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:180px; height:180px; font-size:4rem;">
                👤
            </div>
        }

        <div class="d-grid gap-2">
            <a asp-action="CambiarAvatar" class="btn btn-outline-primary btn-sm">Cambiar Avatar</a>
            
            @if (!string.IsNullOrEmpty(Model.Avatar))
            {
                <form asp-action="EliminarAvatar" method="post" onsubmit="return confirm('¿Eliminar el avatar?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">Eliminar Avatar</button>
                </form>
            }
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Información Personal</h5>
                <p><strong>Nombre:</strong> @Model.NombreCompleto</p>
                <p><strong>Email:</strong> @Model.Email</p>
                <p>
                    <strong>Rol:</strong>
                    <span class="badge @(Model.Rol == "administrador" ? "bg-danger" : "bg-primary")">
                        @Model.Rol
                    </span>
                </p>

                <hr />

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="EditarDatos" class="btn btn-primary">Editar Datos Personales</a>
                    <a asp-action="CambiarClave" class="btn btn-warning">Cambiar Contraseña</a>
                </div>
            </div>
        </div>
    </div>
</div>