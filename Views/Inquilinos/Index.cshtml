@model IEnumerable<Inmobiliaria.Models.Inquilino>

@{
    ViewData["Title"] = "Inquilinos";
}

<h1>Listado de Inquilinos</h1>

<!-- ========================================= -->
<!-- BÚSQUEDA                                  -->
<!-- ========================================= -->

<form asp-action="Index" method="get" class="mb-4 p-3 bg-light rounded border">
    <div class="row g-3 align-items-end">

        <div class="col-md-6">
            <label class="form-label">
                Buscar por nombre o apellido:
            </label>

            <input type="text"
                   name="busqueda"
                   class="form-control"
                   placeholder="Ej: Juan Pérez"
                   value="@ViewBag.BusquedaActual" />
        </div>

        <div class="col-md-2">
            <button type="submit"
                    class="btn btn-primary w-100">
                🔍 Buscar
            </button>
        </div>

        <div class="col-md-2">
            <a asp-action="Index"
               class="btn btn-secondary w-100">
                Limpiar
            </a>
        </div>

    </div>
</form>


<!-- ========================================= -->
<!-- MENSAJES                                  -->
<!-- ========================================= -->

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Crear Nuevo Inquilino
    </a>
</p>


<!-- ========================================= -->
<!-- TABLA                                     -->
<!-- ========================================= -->

<table class="table table-striped table-hover">

    <thead class="table-dark">
        <tr>
            <th>DNI</th>
            <th>Nombre completo</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.Dni
                </td>

                <td>
                    @item.NombreCompleto
                </td>

                <td>
                    @item.Telefono
                </td>

                <td>
                    @item.Email
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.IdInquilino"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.IdInquilino"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.IdInquilino"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>


<!-- ========================================= -->
<!-- PAGINADO                                  -->
<!-- ========================================= -->

@if (ViewBag.TotalPaginas > 1)
{
    <nav aria-label="Paginación de inquilinos">

        <ul class="pagination justify-content-center">

            @{
                int paginaActual = ViewBag.PaginaActual;
                int totalPaginas = ViewBag.TotalPaginas;
                string busqueda = ViewBag.BusquedaActual ?? "";
            }

            <!-- ANTERIOR -->

            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-busqueda="@busqueda"
                   asp-route-pagina="@(paginaActual - 1)">
                    Anterior
                </a>

            </li>


            <!-- NÚMEROS -->

            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-busqueda="@busqueda"
                       asp-route-pagina="@i">
                        @i
                    </a>

                </li>
            }


            <!-- SIGUIENTE -->

            <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-busqueda="@busqueda"
                   asp-route-pagina="@(paginaActual + 1)">
                    Siguiente
                </a>

            </li>

        </ul>

    </nav>
}